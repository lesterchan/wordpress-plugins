{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"plugins": [
		"./freemyinternet",
		"./wp-ban",
		"./wp-commentnavi",
		"./wp-dbmanager",
		"./wp-downloadmanager",
		"./wp-draftsforfriends",
		"./wp-email",
		"./wp-pagenavi",
		"./wp-pluginsused",
		"./wp-polls",
		"./wp-postratings",
		"./wp-postviews",
		"./wp-print",
		"./wp-relativedate",
		"./wp-serverinfo",
		"./wp-showhide",
		"./wp-stats",
		"./wp-sweep",
		"./wp-useronline"
	],
	"phpVersion": "8.2",
	"port": 8888,
	"testsPort": 8889,
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_DISPLAY": true,
		"SCRIPT_DEBUG": true,
		"WP_CACHE": true
	},
	"env": {
		"tests": {
			"config": {
				"WP_DEBUG": true
			}
		}
	},
	"mappings": {
		"wp-content/mu-plugins": "./_standards/demo/mu-plugins",
		"wp-content/demo": "./_standards/demo"
	}
}
